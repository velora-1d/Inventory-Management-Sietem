<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive root files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan) - [F,L]

    # Forward all other requests to Laravel's public/ front controller
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
